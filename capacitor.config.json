{
  "appId": "com.md.carpets",
  "appName": "MD سجاد",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#FAF5EA",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
